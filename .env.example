# Database Configuration
# For local MongoDB: mongodb://localhost:27017/next-ecommerce
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/next-ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/next-ecommerce

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
# IMPORTANT: Use long, randomly generated secrets in production (min 64 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=placeholder_jwt_secret_change_me
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=placeholder_jwt_refresh_secret_change_me
JWT_REFRESH_EXPIRATION=7d

# CORS — comma-separated list of allowed frontend origins (production only).
# In development, http://localhost:3000 is always allowed automatically.
# Example: ALLOWED_ORIGINS=https://lxuy.com,https://www.lxuy.com
ALLOWED_ORIGINS=

# Frontend API URL (production only).
# Points Next.js rewrites to your deployed NestJS API on Railway.
# Example: NEXT_PUBLIC_API_URL=https://api-production.up.railway.app
NEXT_PUBLIC_API_URL=

# Email — Resend (https://resend.com)
# Sign up for a free account and create an API key.
# In development, use 'onboarding@resend.dev' as the FROM address.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=LXUY <noreply@lxuy.com>

# Frontend base URL used in email links.
# In development: http://localhost:3000
# In production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# Backend base URL used for direct redirects or API references.
# In development: http://localhost:3001
# In production: https://api-production-8523.up.railway.app
BACKEND_URL=http://localhost:3001

