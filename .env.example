# Database Configuration
# For local MongoDB: mongodb://localhost:27017/next-ecommerce
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/next-ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/next-ecommerce

# Server Configuration
PORT=3001

# JWT Configuration
JWT_SECRET=placeholder_jwt_secret_change_me
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=placeholder_jwt_refresh_secret_change_me
JWT_REFRESH_EXPIRATION=7d
