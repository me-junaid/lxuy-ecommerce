# =============================================================================
# LXUY ECOMMERCE — ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================
# DO NOT commit real secrets to source control.
# Duplicate this file to `.env` for local development or set these variables
# in your deployment platforms (Railway for Backend, Vercel for Frontend).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND (NestJS on Railway)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3001

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/lxuy?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# CORS Configuration — Comma-separated list of allowed frontend origins.
# In local development, http://localhost:3000 is always allowed automatically.
# In production, specify your Vercel deployment URL and custom domains:
CORS_ORIGIN=https://your-domain.vercel.app,https://your-custom-domain.com
# Alias for backwards compatibility:
ALLOWED_ORIGINS=https://your-domain.vercel.app,https://your-custom-domain.com

# Cookie Security Configuration (Cross-site Vercel <-> Railway)
# Defaults to 'none' in production (required when Vercel & Railway have different domains).
# If both frontend and backend share an apex domain (e.g. app.lxuy.com & api.lxuy.com),
# you can set COOKIE_SAME_SITE=lax and COOKIE_DOMAIN=.lxuy.com.
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=

# JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_long_random_jwt_secret_min_64_chars_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_min_64_chars_here
JWT_REFRESH_EXPIRATION=7d

# Base URLs
# Frontend URL used in email verification links and redirect flows
FRONTEND_URL=https://your-domain.vercel.app
# Backend public URL (Railway public domain, e.g. https://api-production-xxxx.up.railway.app)
BACKEND_URL=https://your-backend.up.railway.app

# Email — Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=LXUY <noreply@yourdomain.com>

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


# -----------------------------------------------------------------------------
# 2. FRONTEND (Next.js on Vercel)
# -----------------------------------------------------------------------------
# Public Railway backend URL accessible from browsers and Next.js SSR.
# NOTE: Must be the public Railway domain (e.g. https://xxx.up.railway.app),
# NOT a private .railway.internal mesh domain.
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Canonical public frontend URL (used in sitemaps, robots.txt, and metadata)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
